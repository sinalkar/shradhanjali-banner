{
  "name": "shradhanjali-banner",
  "version": "1.3.0",
  "private": true,
  "description": "Free memorial/tribute banner generator for Indian families — static site, no runtime dependencies.",
  "license": "MIT",
  "homepage": "https://shradhanjalibanner.in/",
  "repository": {
    "type": "git",
    "url": "https://github.com/sinalkar/shradhanjali-banner.git"
  },
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i src/daisyui.css -o assets/daisyui.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i src/daisyui.css -o assets/daisyui.css --watch",
    "check:css": "npm run build:css && git diff --exit-code --stat assets/daisyui.css",
    "lint:js": "eslint .",
    "lint:html": "html-validate index.html 404.html \"*/index.html\"",
    "format:check": "prettier --check \"**/*.{json,css,yml,yaml,md}\"",
    "format": "prettier --write \"**/*.{json,css,yml,yaml,md}\"",
    "serve": "python3 -m http.server 8080",
    "build:i18n": "node scripts/build-i18n.js",
    "build": "npm run build:css && npm run build:i18n"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "daisyui": "4.12.24",
    "eslint": "^10.8.0",
    "globals": "^17.7.0",
    "html-validate": "^11.5.6",
    "node-html-parser": "^9.0.1",
    "prettier": "^3.4.2",
    "tailwindcss": "3.4.19"
  }
}
